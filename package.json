{
  "name": "yinamp",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "electron/bootstrap.mjs",
  "description": "A skinnable, Winamp-inspired YouTube player.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "desktop": "node electron/launch.mjs",
    "test": "node --test tests/*.test.mjs",
    "prototype": "node experiments/music-sources/launch.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:desktop": "node scripts/prepare-build.mjs && electron-builder --publish never",
    "pack:desktop": "node scripts/prepare-build.mjs && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.4"
  },
  "license": "MIT",
  "author": "Uri Kutner"
}
